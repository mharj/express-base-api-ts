{
    "name": "express-base-api-ts",
    "version": "0.0.2",
    "description": "base express ts setup",
    "main": "dist/service.js",
    "engines": {
        "engineStrict": "true",
        "node": ">=24.0.0"
    },
    "type": "module",
    "dependencies": {
        "@avanio/variable-util": "^1.5.0",
        "@avanio/variable-util-node": "^1.5.0",
        "@luolapeikko/express-standard-schema": "^0.0.14",
        "cross-env": "^10.1.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "log4js": "^6.9.1",
        "source-map-support": "^0.5.21",
        "tslib": "^2.8.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@types/etag": "^1.8.4",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "c8": "^12.0.0",
        "nodemon": "^3.1.14",
        "npm-run-all": "^4.1.5",
        "ttsc": "^0.34.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "cross-env TS_NODE_FILES=true NODE_ENV=development nodemon",
        "test": "vitest test --typecheck --run --no-isolate --coverage",
        "start": "cross-env NODE_ENV=production node -r source-map-support/register ./dist/service.js",
        "lint": "biome check",
        "validate": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mharj/express-base-api-ts.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/mharj/express-base-api-ts/issues"
    },
    "homepage": "https://github.com/mharj/express-base-api-ts#readme"
}